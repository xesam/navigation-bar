/**index.wxss**/
page {
    height: 100vh;
}

.scrollarea {
    flex: 1;
    overflow-y: hidden;
}

.section-title {
    padding: 16rpx 32rpx;
    font-size: 28rpx;
    color: #999;
    background: #fafafa;
}

.left{
    display: flex;
    align-items: center;
    font-size: 0.8em;
}

.icon{
    width:48rpx;
    height: 48rpx;
}

.demo-bar {
    background: #f5f5f5;
    border-bottom: 1rpx solid #e5e5e5;
}

.row {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0;
}

.right {
    font-size: 16px;
    color: #333;
}

.center {
    font-size: 17px;
    font-weight: bold;
    color: #333;
}

.base1{
    background:#ff5500;
}

.base2{
    background:#f5f550;
}