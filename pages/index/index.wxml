<scroll-view class="scrollarea" scroll-y type="list">
    <nav-bar-base ext-class="demo-bar base1">
        <view class="row">
            <view class="left" bind:tap="onTapLeft">Base组件</view>
            <view class="right" bind:tap="onTapRight">菜单</view>
        </view>
    </nav-bar-base>
    <nav-bar-base ext-class="demo-bar base2">
        <view class="row">
            <view class="center">自定义Base组件内容</view>
        </view>
    </nav-bar-base>
    <view class="section-title">完整组件 navigation-bar</view>
    <navigation-bar title="标题文字" back="{{false}}" home-button="{{true}}" color="black" loading background="#ff5500">
        <view slot="right">右侧</view>
    </navigation-bar>
    <navigation-bar title="标题文字" back="{{false}}" color="black" background="#f5f5f5"></navigation-bar>
    <navigation-bar title="标题Loading" back="{{true}}" color="black" background="#f5f550" loading bindback="back"></navigation-bar>
    <navigation-bar title="HomeButton" back="{{false}}" home-button="{{true}}" color="black" background="#f5f5f5" bindhome="home" loading></navigation-bar>
    <navigation-bar title="自定义Left" back="{{false}}" color="black" background="#f5f5f5" loading>
        <view slot="left">回退</view>
    </navigation-bar>
    <navigation-bar title="自定义Left" back="{{false}}" color="black" background="#f5f5f5" loading>
        <view slot="left" class="left" bind:tap="onTapNew">
            <image class="icon" src="./icon.svg"/>
            <text>新页面</text>
        </view>
    </navigation-bar>
    <navigation-bar title="自定义Right" back="{{false}}" color="black" background="#f5f5f5" loading>
        <view slot="right">切换</view>
    </navigation-bar>
    <navigation-bar back="{{false}}" color="black" background="#f5f5f5" loading>
        <view slot="center">标题文字LongTitle</view>
    </navigation-bar>
    <navigation-bar title="自定义图标-Back" back="{{true}}" color="black" background="#f5f5f5" backIcon="/pages/index/icon.svg" bindback="back"></navigation-bar>
    <navigation-bar title="自定义图标-Home" back="{{false}}" home-button="{{true}}" color="black" background="#f5f5f5" homeIcon="/pages/index/icon.svg" bindhome="home"></navigation-bar>


</scroll-view>
